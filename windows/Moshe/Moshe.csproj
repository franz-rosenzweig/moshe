<Project Sdk="Microsoft.NET.Sdk">
  <!-- Moshe for Windows (windows/README.md): WinUI 3 and WebView2 around the web
       app, which is built from frontend/ (npm run build) and copied in as web/.
       Unpackaged and self-contained: the folder dotnet publish makes runs as it
       is, and the installer only copies it. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Moshe</RootNamespace>
    <AssemblyName>Moshe</AssemblyName>
    <Version>0.1.3</Version>
    <Product>Moshe</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- windows/tools/make-icon.ps1 makes it from frontend/public/icons -->
  <PropertyGroup Condition="Exists('Assets\Moshe.ico')">
    <ApplicationIcon>Assets\Moshe.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <!-- writing by voice (Voice.cs): whisper.cpp on the processor, and the microphone through WaveIn -->
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="NAudio.WinMM" Version="3.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Moshe.Core\Moshe.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Moshe.ico" Condition="Exists('Assets\Moshe.ico')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\frontend\dist\**\*" LinkBase="web" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Whisper's models, built in as Models\ (windows/tools/get-models.ps1 fetches them into
       build\models): base.en, and with build.ps1 -SmallModel small.en too -->
  <PropertyGroup>
    <VoiceModels Condition="'$(VoiceModels)' == ''">base.en</VoiceModels>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="..\..\build\models\ggml-base.en.bin" Condition="$(VoiceModels.Contains('base.en')) And Exists('..\..\build\models\ggml-base.en.bin')"
             Link="Models\ggml-base.en.bin" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\build\models\ggml-small.en.bin" Condition="$(VoiceModels.Contains('small.en')) And Exists('..\..\build\models\ggml-small.en.bin')"
             Link="Models\ggml-small.en.bin" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
